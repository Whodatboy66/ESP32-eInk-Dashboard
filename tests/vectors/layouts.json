    {"name": "agenda in a 1 x 3 box", "statusBar": true, "valid": false, "rule": "size",
     "boxes": [{"c": 0, "r": 0, "w": 1, "h": 3, "widget": "agenda"}, {"c": 1, "r": 0, "w": 3, "h": 3, "widget": "month"}]}
