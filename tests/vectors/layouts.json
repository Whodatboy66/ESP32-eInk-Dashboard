               {"c": 2, "r": 0, "w": 1, "h": 1, "widget": null}, {"c": 3, "r": 0, "w": 1, "h": 1, "widget": null},
               {"c": 0, "r": 1, "w": 1, "h": 1, "widget": null}, {"c": 1, "r": 1, "w": 1, "h": 1, "widget": null},
               {"c": 2, "r": 1, "w": 1, "h": 1, "widget": null}, {"c": 3, "r": 1, "w": 1, "h": 1, "widget": null},
               {"c": 0, "r": 2, "w": 1, "h": 1, "widget": null}, {"c": 1, "r": 2, "w": 1, "h": 1, "widget": null},
               {"c": 2, "r": 2, "w": 1, "h": 1, "widget": null}, {"c": 3, "r": 2, "w": 1, "h": 1, "widget": null},
               {"c": 3, "r": 2, "w": 1, "h": 1, "widget": null}]},
    {"name": "widget twice", "statusBar": true, "valid": false, "rule": "duplicate",
