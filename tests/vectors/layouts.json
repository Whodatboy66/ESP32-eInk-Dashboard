{
  "about": "Shared layout test vectors for web/layout.js (tests/web/layout.test.cjs) and the firmware layout engine. Grid 4 x 3. 'rule' names the broken rule of an invalid case: outside, overlap, gap, count, duplicate, unknown, size. Each invalid case breaks only that rule, except 'thirteen boxes' (13 boxes can't fit 12 cells without an overlap).",
  "widgets": [
    {"key": "clock", "minW": 2, "minH": 1},
    {"key": "weather", "minW": 1, "minH": 1},
    {"key": "agenda", "minW": 2, "minH": 1},
    {"key": "month", "minW": 2, "minH": 2},
    {"key": "stocks", "minW": 2, "minH": 1},
    {"key": "tracking", "minW": 2, "minH": 1},
    {"key": "printer", "minW": 2, "minH": 1},
    {"key": "tasks", "minW": 2, "minH": 1},
    {"key": "notes", "minW": 1, "minH": 1},
    {"key": "birthdays", "minW": 2, "minH": 1}
  ],
  "cases": [
