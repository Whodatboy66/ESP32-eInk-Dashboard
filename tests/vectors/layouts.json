    {"name": "unknown widget", "statusBar": true, "valid": false, "rule": "unknown",
     "boxes": [{"c": 0, "r": 0, "w": 4, "h": 3, "widget": "radio"}]},
    {"name": "clock in a 1 x 1 box", "statusBar": true, "valid": false, "rule": "size",
     "boxes": [{"c": 0, "r": 0, "w": 1, "h": 1, "widget": "clock"}, {"c": 1, "r": 0, "w": 3, "h": 1, "widget": null},
               {"c": 0, "r": 1, "w": 4, "h": 2, "widget": "agenda"}]},
    {"name": "month in a 4 x 1 box", "statusBar": false, "valid": false, "rule": "size",
