               {"c": 0, "r": 1, "w": 2, "h": 2, "widget": "agenda"}, {"c": 2, "r": 1, "w": 2, "h": 2, "widget": "month"}]},
    {"name": "six boxes, no clock", "statusBar": false, "valid": true,
     "boxes": [{"c": 0, "r": 0, "w": 2, "h": 1, "widget": "tasks"}, {"c": 2, "r": 0, "w": 2, "h": 1, "widget": "weather"},
               {"c": 0, "r": 1, "w": 2, "h": 1, "widget": "agenda"}, {"c": 2, "r": 1, "w": 2, "h": 1, "widget": "stocks"},
               {"c": 0, "r": 2, "w": 2, "h": 1, "widget": "tracking"}, {"c": 2, "r": 2, "w": 2, "h": 1, "widget": "birthdays"}]},
    {"name": "big + 2 small", "statusBar": true, "valid": true,
